{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.1.12",
  "identifier": "com.folio.reader",
  "app": {
    "windows": [
      {
        "title": "Folio",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": "all",
    "resources": [],
    "shortDescription": "A local ebook and PDF reader with on-device narration.",
    "longDescription": "Folio opens EPUB and PDF books, remembers reading state, and reads locally on Android without a cloud backend.",
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "EPUB eBook",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ]
  }
}
