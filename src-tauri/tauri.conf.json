{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.1.11",
  "identifier": "com.folio.reader",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev-tauri.ps1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-frontend.ps1",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Folio",
        "width": 1280,
        "height": 900,
        "minWidth": 860,
        "minHeight": 680,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "publisher": "Folio contributors",
    "category": "Reference",
    "shortDescription": "A desktop EPUB reader with local read-aloud narration.",
    "longDescription": "Folio opens EPUB books, remembers your reading state, and generates local sentence-aware narration on your PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "EPUB eBook",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      }
    ],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "upgradeCode": "44dd72fc-4aae-429b-8756-94f81138c90d"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzRUU1RkFDQTIwQ0YwNDgKUldSSThBeWlyRi91STR5L2dadE9sYnArUVA1R0MrQ0RVSkxiWVdrSi9TR3E0WXhEdFFSS3N6UEUK",
      "endpoints": [
        "https://github.com/Retrorerr/Folio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
